{
  "name": "clash-of-critters-scraper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev-wifi": "vite --open --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test scraper/test/*.test.js",
    "check": "tsc -b && oxlint && node --test scraper/test/*.test.js",
    "preview": "vite preview",
    "scrape_app": "node scraper/app_scraper.js",
    "force_app": "node scraper/app_scraper.js --force",
    "data_app": "node scraper/app_scraper.js --skip-images --yes"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
